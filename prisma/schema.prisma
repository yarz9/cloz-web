generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id            String   @id @default(uuid())
  uid           Int      @unique @default(autoincrement()) // sequential public user ID (#1, #2, …)
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  bio           String?
  discordId     String?  @unique
  hwids         String?  // JSON array of registered HWIDs
  role          String   @default("user") // user | moderator | admin | founder | developer
  verified      Boolean  @default(false)
  frozen        Boolean  @default(false) // frozen/banned — blocked from signing in & posting
  plan          String   @default("free") // free | pro | lifetime
  resetToken        String?
  resetTokenExpiry  DateTime?
  verifyToken       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  licenses      License[]
  presets        Preset[]       @relation("PresetAuthor")
  reviews        Review[]
  favorites      Favorite[]
  downloads      Download[]
  syncData       SyncData[]
  devices        Device[]
  sessions       Session[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  name      String
  hwid      String
  os        String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, hwid])
}

// ==================== LICENSING ====================

model License {
  id           String    @id @default(uuid())
  key          String    @unique
  userId       String?
  plan         String    // monthly | 3month | yearly | lifetime
  status       String    @default("active") // active | expired | revoked
  hwid         String?
  activatedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id])
}

// ==================== MARKETPLACE ====================

model Preset {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String
  longDesc      String?
  category      String   // ui | game | windows | optimization | theme | dashboard | widget
  authorId      String
  version       String   @default("1.0.0")
  tags          String?  // JSON array
  screenshots   String?  // JSON array of URLs
  configData    String?  // JSON preset config
  compatibility String?  // JSON compatibility info
  changelog     String?
  verified      Boolean  @default(false)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  downloadCount Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author    User       @relation("PresetAuthor", fields: [authorId], references: [id])
  reviews   Review[]
  favorites Favorite[]
  downloads Download[]
  versions  PresetVersion[]
}

model PresetVersion {
  id        String   @id @default(uuid())
  presetId  String
  version   String
  changelog String?
  configData String?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  presetId  String
  userId    String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([presetId, userId])
}

model Favorite {
  id        String   @id @default(uuid())
  presetId  String
  userId    String
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([presetId, userId])
}

model Download {
  id        String   @id @default(uuid())
  presetId  String
  userId    String?
  version   String?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

// ==================== CLOUD SYNC ====================

model SyncData {
  id        String   @id @default(uuid())
  userId    String
  key       String   // e.g. "settings", "profiles.gaming", "theme"
  value     String   // JSON blob
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}
