# ----------------------------------------------------------------------------
# ClozOptimizer website — environment variables
# Copy to .env for local dev, or set these in Railway → cloz-web → Variables.
# ----------------------------------------------------------------------------

# Database (Railway Postgres). Locally you can point at a local Postgres.
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Auth — long random strings (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
MOD_SECRET="change-me-shared-with-the-discord-bot"

# Public site URL (used in emails, OAuth redirects, update feed)
NEXT_PUBLIC_APP_URL="https://cloz-optimizer.up.railway.app"

# ---- Email (Resend) -------------------------------------------------------
# Create a Resend account, verify the cloz.digital domain (add DNS records),
# then paste the API key. Sender defaults to general@cloz.digital.
RESEND_API_KEY=""
EMAIL_FROM="Cloz <general@cloz.digital>"

# ---- Discord (bot + OAuth role sync) --------------------------------------
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""            # Discord Dev Portal -> OAuth2
DISCORD_GUILD_ID=""                 # your server ID
DISCORD_PRESET_CHANNEL_ID=""        # marketplace approval channel
DISCORD_ROLE_PRO=""                 # role ID granted to Pro members
DISCORD_ROLE_LIFETIME=""            # role ID granted to Lifetime members
DISCORD_ROLE_CREATOR=""             # role ID granted to creators/staff
# Also add this OAuth redirect in the Discord Dev Portal:
#   https://cloz-optimizer.up.railway.app/api/auth/discord/callback

# ---- Sell.app checkout ----------------------------------------------------
# Product checkout URLs (NEXT_PUBLIC_* are baked at build time -> redeploy after changing)
NEXT_PUBLIC_SELLAPP_1MONTH=""
NEXT_PUBLIC_SELLAPP_3MONTH=""
NEXT_PUBLIC_SELLAPP_12MONTH=""
NEXT_PUBLIC_SELLAPP_LIFETIME=""
# Webhook: set the same value on the sell.app webhook (header x-sellapp-secret)
# pointing at https://cloz-optimizer.up.railway.app/api/webhooks/sellapp
SELLAPP_WEBHOOK_SECRET=""

# ---- Private download / auto-update feed ----------------------------------
# Fine-grained GitHub PAT (Contents: Read on cloz-web). Lets the app download +
# auto-update through the website even when the repo is private. Leave blank
# while the repo is public.
GITHUB_TOKEN=""
GITHUB_RELEASE_REPO="yarz9/cloz-web"
